local function createiOSButton(text, yPos, color)
	local btn = Instance.new("TextButton")
	btn.Text = text
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 17
	btn.Size = UDim2.new(1, -30, 0, 50)
	btn.Position = UDim2.new(0, 15, 0, yPos)
	btn.BackgroundColor3 = color
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.ZIndex = 10
	btn.AutoButtonColor = false
	btn.Parent = main
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 14)
	return btn
end


local function safeHttpGet(url)
	local suc, res = pcall(function()
		if syn and syn.request then
			return syn.request({Url = url, Method = "GET"}).Body
		elseif request then
			return request({Url = url, Method = "GET"}).Body
		elseif http_request then
			return http_request({Url = url, Method = "GET"}).Body
		else
			return game:HttpGet(url)
		end
	end)
	if suc then return res else warn("HttpGet failed:", res) return nil end
end

local function safeLoad(code)
	if not code then return end
	local suc, err = pcall(loadstring(code))
	if not suc then warn("Script Error:", err) end
end


